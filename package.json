{
  "name": "chamados-ti",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicação web para abertura e acompanhamento de chamados de suporte técnico, feita em TypeScript puro, sem framework, com manipulação direta do DOM.",
  "type": "module",
  "scripts": {
    "start": "npm run build && npx --yes serve .",
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "all",
    "printWidth": 80,
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrodriguescunha/chamados-ti.git"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  }
}
